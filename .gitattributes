# Emitted JSON Schema artifacts and example CSV fixtures are byte-compared by the
# drift guard / loaded cross-platform. Pin LF so Windows autocrlf settings can't
# rewrite line endings and make CI diverge.
schema/*.json text eol=lf
src/sleap_roots_contracts/examples/*.csv text eol=lf
openspec/**/*.md text eol=lf
docs/**/*.md text eol=lf
package-lock.json text eol=lf linguist-generated=true -diff
